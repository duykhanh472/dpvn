# Copy to .env and fill in real values. Never commit .env.
#
# Generate secrets with:  openssl rand -base64 32

DB_PASSWORD=change-me-app-password
DB_ROOT_PASSWORD=change-me-root-password

# Public origin used for links and cookies. Must match the TLS hostname.
DP_PUBLIC_URL=https://proof.example.org

# SMTP relay used for activation email.
DP_SMTP_URL=smtp://localhost:25

# Logging. JSON is recommended in production; see docs/operations/logging.md.
RUST_LOG=info,dp_web=info,dp_db=warn
